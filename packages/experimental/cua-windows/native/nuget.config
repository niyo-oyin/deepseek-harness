<?xml version="1.0" encoding="utf-8"?>
<!--
  The helper restores from nuget.org only, whatever sources the machine
  configures. Its project packages are pinned with content hashes in each
  project's packages.lock.json; restore with locked mode to keep them so.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
