/** Product name: executable name, default installation directory, shortcuts, and uninstall entry. */
export const DESKTOP_PRODUCT_NAME: string

/** Packaged manifest name; Electron derives the default userData directory from it. */
export const DESKTOP_PACKAGE_NAME: string

/** Installer file name prefix: `<prefix>-<version>-<os>-<arch>[-unsigned|-unnotarized].<ext>`. */
export const DESKTOP_ARTIFACT_PREFIX: string
