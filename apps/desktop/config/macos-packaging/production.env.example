# Copy to production.env in the same machine configuration directory and fill in the values.
DSH_DESKTOP_APP_ID=app.ndsh.desktop
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=
